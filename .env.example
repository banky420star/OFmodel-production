# Persona Production Line — configuration template.
# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# ── Database ──────────────────────────────────────────────────────────
# Local dev (default): SQLite. Production / docker-compose: Postgres.
DATABASE_URL=sqlite+aiosqlite:///./persona_studio.db
# DATABASE_URL=postgresql+asyncpg://persona:persona@localhost:5432/persona

# ── Application ───────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# ── Provider selection (real providers only — no mock mode exists) ────
# One explicit choice per capability. A missing credential fails fast at
# startup and 503s on the endpoints that need it.
LLM_PROVIDER=ollama                # ollama
IMAGE_PROVIDER=dashscope           # dashscope | eachsense | comfyui | huggingface
VIDEO_PROVIDER=dashscope_wan       # dashscope_wan | wan_server
VOICE_PROVIDER=macos_say           # macos_say | elevenlabs
TRAINER_PROVIDER=hf                # hf (local MPS/CUDA LoRA trainer)
STORAGE_PROVIDER=filesystem        # filesystem | minio
MODERATION_PROVIDER=huggingface    # huggingface (required — fail-closed)

# ── Provider credentials / endpoints ──────────────────────────────────
# DashScope (Alibaba Cloud) — qwen-image + qwen-image-edit + Wan video
WAN_API_KEY=
DASHSCOPE_API_KEY=
# EachLabs each::sense — adult-capable image generation
EACHLABS_API_KEY=
EACHSENSE_MODE=max                 # max | eco
# ElevenLabs — voice design + synthesis
ELEVENLABS_API_KEY=
# HuggingFace — image fallback AND the NSFW moderation model (required)
HUGGINGFACE_API_KEY=
# Ollama — local LLM (must be running)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# ComfyUI — local GPU image generation (alternative image provider).
# Set IMAGE_PROVIDER=comfyui and point this at the ComfyUI server.
COMFYUI_URL=http://127.0.0.1:8188
# Exact checkpoint filename installed in ComfyUI/models/checkpoints.
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Self-hosted Wan-compatible video server (alternative video provider)
WAN_VIDEO_URL=

# ── Instagram analytics (optional — real Graph API sync) ──────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── TikTok Login Kit + Display API (optional — read-only analytics) ────
# Developer app credentials from https://developers.tiktok.com. Requires the
# Login Kit for Web product with scopes: user.info.basic, user.info.profile,
# user.info.stats, video.list. The redirect URI must be HTTPS (TikTok rejects
# localhost over http) and must reach this API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ── Fanvue publishing (the only real external publish path) ───────────
# Fanvue has a public creator API and permits a disclosed AI persona as a
# first-class account, which is why it is the one platform wired here. OAuth 2.0
# only — authorization code with PKCE and rotating refresh tokens, no static API
# keys — so every value below comes from one authorization you perform, against
# your own account. See app/providers/publish/fanvue.py.
#
# These are YOUR credentials for YOUR account. Do not paste them anywhere else,
# and complete the authorization yourself rather than having a tool do it.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# The redirect URI registered on your Fanvue client. Must match byte for byte,
# including scheme and any trailing slash, or the token exchange is refused.
FANVUE_REDIRECT_URI=
# Where the browser is sent to approve, and where the code is traded for tokens.
# Both are from the published spec (api.fanvue.com/docs/openapi-v1.json,
# securityScheme BearerAuth). FANVUE_AUTH_URL is misnamed — it is the *token*
# endpoint — and is kept that way for .env files that already set it.
FANVUE_AUTHORIZE_URL=https://auth.fanvue.com/oauth2/auth
FANVUE_AUTH_URL=https://auth.fanvue.com/oauth2/token
# Fill these two in by running the flow, not by hand:
#   1. GET /api/v1/fanvue/connect      → open the URL it returns in a browser
#   2. approve it on fanvue.com        → you land back on the callback
# That writes the live pair to apps/api/storage/oauth_tokens.json (mode 0600,
# gitignored) and tells you the creator UUID it read. The lines below are seed
# values only, read when the store has nothing — the store wins, because a pair
# rotated at runtime is newer than the .env line it came from.
FANVUE_ACCESS_TOKEN=
FANVUE_REFRESH_TOKEN=
# Your creator user UUID. Every media and post path is keyed by it; there is no
# discovery fallback, so an empty value means "not configured". The connect flow
# reports the value it read — GET /fanvue/status compares the two and says so if
# they point at different creators, which is the failure that looks authorized
# and 404s on every path.
FANVUE_CREATOR_UUID=

# ── Adult content (OFF by default; four-layer gate) ───────────────────
ADULT_CONTENT_ENABLED=false
# Declares that the loaded COMFYUI_CHECKPOINT is adult-tuned. This is an
# assertion, not a detection — ComfyUI loads any weights, so setting this true
# over a stock checkpoint makes the gate pass on output that will be filtered
# or mangled. The running state is reported at GET /system/providers → gates.
COMFYUI_ADULT_CHECKPOINT=false

# ── Automated platform signup (OFF, and refused while off) ────────────
# Enables POST /social-accounts/{id}/auto-signup and /auto-signup-all, which
# drive Playwright against a live platform using anti-automation flags and a
# mail.tm disposable-inbox code bypass, and create real accounts when they work.
# The routes return 403 while this is false. The supported path is each
# account's manual signup packet (GET /social-accounts/{id}/signup-packet).
AUTO_SIGNUP_ENABLED=false

# ── Posting to a real platform (OFF) ──────────────────────────────────
# Separate from the credentials on purpose: a token in this file must not be
# the same act as deciding the line may post with it, or a value copied in for a
# read-only check would silently become permission to publish. While false the
# publisher raises PublishDisabled and the line records blocked_gate.
FANVUE_PUBLISH_ENABLED=false

# ── What a sellable post costs (UNSET) ────────────────────────────────
# Dollars. The calendar will not create a slot on a platform that sells until
# this is set, and the publish path refuses an unpriced post there — because on
# Fanvue "no price" does not mean "no decision", it means the post goes out
# free. That refusal is deliberate: a calendar of giveaways looks identical to a
# calendar of inventory right up until the money doesn't arrive.
#
# Leaving it blank means no price has been stated, which is a refusal and not
# zero. Fanvue's floor is $3.00; set the value you actually want to charge.
DEFAULT_PPV_PRICE=

# ── Workflow limits ───────────────────────────────────────────────────
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_STEP_TIMEOUT_SECONDS=600

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=USD