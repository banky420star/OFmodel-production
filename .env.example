# Persona Production Line — configuration template.
# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# ── Database ──────────────────────────────────────────────────────────
# Local dev (default): SQLite. Production / docker-compose: Postgres.
DATABASE_URL=sqlite+aiosqlite:///./persona_studio.db
# DATABASE_URL=postgresql+asyncpg://persona:persona@localhost:5432/persona

# ── Application ───────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# ── Provider selection (real providers only — no mock mode exists) ────
# One explicit choice per capability. A missing credential fails fast at
# startup and 503s on the endpoints that need it.
LLM_PROVIDER=ollama                # ollama
IMAGE_PROVIDER=dashscope           # dashscope | eachsense | comfyui | huggingface
VIDEO_PROVIDER=dashscope_wan       # dashscope_wan | wan_server
VOICE_PROVIDER=macos_say           # macos_say | elevenlabs
TRAINER_PROVIDER=hf                # hf (local MPS/CUDA LoRA trainer)
STORAGE_PROVIDER=filesystem        # filesystem | minio
MODERATION_PROVIDER=huggingface    # huggingface (required — fail-closed)

# ── Provider credentials / endpoints ──────────────────────────────────
# DashScope (Alibaba Cloud) — qwen-image + qwen-image-edit + Wan video
WAN_API_KEY=
DASHSCOPE_API_KEY=
# EachLabs each::sense — adult-capable image generation
EACHLABS_API_KEY=
EACHSENSE_MODE=max                 # max | eco
# ElevenLabs — voice design + synthesis
ELEVENLABS_API_KEY=
# HuggingFace — image fallback AND the NSFW moderation model (required)
HUGGINGFACE_API_KEY=
# Ollama — local LLM (must be running)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# ComfyUI — local GPU image generation (alternative image provider).
# Set IMAGE_PROVIDER=comfyui and point this at the ComfyUI server.
COMFYUI_URL=http://127.0.0.1:8188
# Exact checkpoint filename installed in ComfyUI/models/checkpoints.
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Self-hosted Wan-compatible video server (alternative video provider)
WAN_VIDEO_URL=

# ── Instagram analytics (optional — real Graph API sync) ──────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Adult content (OFF by default; four-layer gate) ───────────────────
ADULT_CONTENT_ENABLED=false

# ── Workflow limits ───────────────────────────────────────────────────
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_STEP_TIMEOUT_SECONDS=600

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=USD