[TEMPLATE]
# ═══════════════════════════════════════════════════════
# PERSONA STUDIO — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://persona:persona_secret@localhost:5432/persona_studio
DATABASE_URL_SYNC=postgresql://persona:persona_secret@localhost:5432/persona_studio

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / Object Storage ────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=persona
MINIO_SECRET_KEY=persona_secret
MINIO_BUCKET=persona-studio
MINIO_SECURE=false

# ─── Application ───────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ─── Provider Registry ─────────────────────────────────
# Options: mock | comfyui | hybrid | elevenlabs | wan_video | ollama
# mock = all deterministic mock providers (no GPU/cloud needed)
# hybrid = mock where real provider unavailable, real where available
# comfyui = use ComfyUI for images
# elevenlabs = use ElevenLabs for voice
# wan_video = use Wan for video
# ollama = use local Ollama for LLM decisions
PROVIDER_REGISTRY=mock

# ─── ComfyUI (Image Generation) ───────────────────────
# ComfyUI API endpoint — requires ComfyUI running with SD/SDXL/Flux
COMFYUI_URL=http://localhost:8188

# ─── Ollama (Local LLM) ───────────────────────────────
# Ollama endpoint for local LLM inference
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── ElevenLabs (Voice Synthesis) ─────────────────────
# Get your API key from https://elevenlabs.io
ELEVENLABS_API_KEY=

# ─── Wan Video (Video Generation) ─────────────────────
# Wan2.1 / CogVideoX video generation server
WAN_VIDEO_URL=http://localhost:8080

# ─── EachLabs each::sense (adult-capable image generation) ──
# Top-priority image provider when set; get a key at https://eachlabs.ai -> API Keys
# EACHLABS_API_KEY=sk_...
# EACHSENSE_MODE=max

# ─── GPU Worker (Remote) ──────────────────────────────
# URL of remote GPU worker for heavy compute tasks
# Set this when running Persona Studio on a Mac but GPU is on a remote machine
GPU_WORKER_URL=

# ─── Celery Worker ─────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Workflow Engine ───────────────────────────────────
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_STEP_TIMEOUT_SECONDS=300

# ─── Content Generation Defaults ───────────────────────
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
DEFAULT_VIDEO_DURATION=4.0
DEFAULT_VIDEO_FPS=24
DEFAULT_LORA_STRENGTH=0.8
DEFAULT_STEPS=30
DEFAULT_CFG_SCALE=7.0

# ─── Always-on social worker (official platform APIs ONLY) ──────────────
# The worker integrates ONLY platforms with official APIs. Fansly and
# OnlyFans have no official API and are deliberately NOT integrated.
#
# Fanvue — official OAuth2 API (https://api.fanvue.com/docs):
#   1. Fanvue creator account with completed KYC
#   2. Create an OAuth app, authorize it, copy the access token
#   3. Store per-account via the Studio: POST /api/v1/social-worker/connect-api
#      (or as a global fallback here)
# FANVUE_ACCESS_TOKEN=
#
# X (Twitter) — official API v2 (https://developer.x.com):
#   Bearer token from your X Developer Portal app. v2 POST /2/tweets needs
#   Basic tier or higher; Free tier is write-limited.
# X_BEARER_TOKEN=
#
# TikTok / Instagram / Facebook — official APIs exist but are gated behind
#   developer-app approval (TikTok Content Posting API, Meta App Review).
#   The Studio reports them as NOT_CONFIGURED until you complete approval.
#
# SOCIAL_WORKER_ENABLED=true
# SOCIAL_WORKER_INTERVAL_SECONDS=300
